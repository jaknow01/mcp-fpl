# mcp-fpl — environment (copy to .env for local runs; in k8s use a Secret)
MCP_HOST=0.0.0.0
MCP_PORT=8010
MCP_CLIENTS_CONFIG=config/clients.yaml
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_TOOL_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
DATABASE_URL=postgresql://mcp_fpl:password@localhost:5432/mcp_fpl
FPL_LEAGUES=
FPL_DRAFT_LEAGUES=
JOIN_NOTIFY_WEBHOOK_URL=
JOIN_NOTIFY_TOKEN=
MCP_PUBLIC_URL=
